RewriteEngine On
RewriteBase /

# Redirecciones simples
RewriteRule ^auth/login$ auth/login.php [L]
RewriteRule ^auth/me$ auth/me.php [L]
RewriteRule ^movies$ api/movies.php [L]
RewriteRule ^series$ api/series.php [L]
RewriteRule ^channels$ api/channels.php [L]
RewriteRule ^profiles$ api/profiles.php [L]
RewriteRule ^favorites$ api/favorites.php [L]
